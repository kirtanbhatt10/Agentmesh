# AgentMesh — example environment configuration
#
# This file lists placeholder configuration names for the planned Python/FastAPI
# reference implementation. Copy to `.env` and fill in real values locally.
# NEVER commit real secrets or API keys.

# --- General ---
# Runtime environment: development | staging | production
AGENTMESH_ENV=development

# --- Redis (transient task state and conversation correlation) ---
# Placeholder; no real credentials here.
REDIS_URL=redis://localhost:6379/0

# --- LLM execution (LiteLLM or Ollama; not part of the protocol contract) ---
# Provider hint: litellm | ollama
LLM_PROVIDER=
# Model identifier, e.g. a LiteLLM model string or an Ollama model tag
LLM_MODEL=
# API key placeholder for LiteLLM-backed providers — supply via your local .env only
LITELLM_API_KEY=

# --- Agent service (planned minimal agent API, Phase 2) ---
AGENT_NAME=
AGENT_BASE_URL=http://localhost:8000
AGENT_PORT=8000

# --- Registry (planned discovery, Phase 2) ---
REGISTRY_URL=

# --- Webhooks (planned async task notifications, Phase 4) ---
WEBHOOK_CALLBACK_URL=

# --- Logging ---
# debug | info | warning | error
LOG_LEVEL=info
